POSTGRES_DSN=PASTE_RENDER_POSTGRES_INTERNAL_URL_HERE

REDIS_HOST=PASTE_RENDER_REDIS_HOST_HERE
REDIS_PORT=6379

MINIO_ENDPOINT=PASTE_MINIO_ENDPOINT_HERE
MINIO_ACCESS_KEY=PASTE_MINIO_ACCESS_KEY_HERE
MINIO_SECRET_KEY=PASTE_MINIO_SECRET_KEY_HERE
MINIO_BUCKET=documents
MINIO_SECURE=false

JWT_SECRET_KEY=PASTE_LONG_RANDOM_SECRET_HERE
JWT_EXPIRE_MINUTES=1440

LLM_PROVIDER=gigachat
LLM_TIMEOUT_SECONDS=300

GIGACHAT_AUTH_KEY=PASTE_GIGACHAT_AUTH_KEY_HERE
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_MODEL=GigaChat-2

# Ollama оставляем как запасной локальный вариант, на Render не используем
LLM_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=gemma3:4b

CORS_ORIGINS=["PASTE_FRONTEND_RENDER_URL_HERE","http://localhost:3000","http://localhost:5173"]